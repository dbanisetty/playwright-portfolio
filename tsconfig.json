{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@config": ["config/index"],
      "@config/*": ["config/*"],
      "@test-kit/*": ["test-kit/*"],
      "@reporting/*": ["reporting/*"],
      "@data/*": ["data/*"],
      "@ui/*": ["ui/*"],
      "@domain/*": ["domain/*"],
      "@fixtures": ["fixtures/index"],
      "@fixtures/*": ["fixtures/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "playwright-report", "test-results", "blob-report"]
}
