# Copy to .env and adjust. Every var here is optional — the defaults target the
# public OrangeHRM demo in headless mode.

# Target environment: demo | local
ENV=demo

# Override the base URL (defaults per ENV, see config/defaults.ts)
# BASE_URL=https://opensource-demo.orangehrmlive.com

# Run the browser headed
HEADLESS=true

# Override parallelism / retries
# WORKERS=4
# RETRIES=0
